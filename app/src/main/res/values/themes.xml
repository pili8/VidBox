<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 夜间主题（默认） -->
    <style name="Theme.VideoSwiper" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="colorPrimary">#FF6200EE</item>
        <item name="colorPrimaryVariant">#FF3700B3</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
    </style>

    <!-- 日间主题 -->
    <style name="Theme.VideoSwiper.Light" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:statusBarColor">#FF333333</item>
        <item name="android:navigationBarColor">#FF333333</item>
        <item name="colorPrimary">#FF6200EE</item>
        <item name="colorPrimaryVariant">#FF3700B3</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
    </style>

    <!-- 设置页主题（不全屏，有状态栏） -->
    <style name="Theme.VideoSwiper.Settings" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:statusBarColor">#FF1A1A2E</item>
        <item name="android:navigationBarColor">#FF000000</item>
        <item name="colorPrimary">#FF6C63FF</item>
    </style>

    <style name="Theme.VideoSwiper.Settings.Light" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:statusBarColor">#FFF5F5F5</item>
        <item name="android:navigationBarColor">#FFFFFFFF</item>
        <item name="colorPrimary">#FF6C63FF</item>
    </style>
</resources>
